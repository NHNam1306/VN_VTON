# Backend local
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# local: SQLite + auth tự quản + thư mục file. Production: postgres + supabase + r2.
PERSISTENCE_BACKEND=sqlite
AUTH_BACKEND=local
IMAGE_STORAGE=local
AUTH_SESSION_DAYS=30
# Email bootstrap admin, phân tách bằng dấu phẩy. Sau lần đăng nhập đầu, role được lưu trong DB.
ADMIN_EMAILS=
# Production HTTPS mặc định bật Secure khi NODE_ENV=production; local HTTP đặt false.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=
API_REQUESTS_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
AUTH_LOGIN_ACCOUNT_PER_15_MIN=10
AUTH_LOGIN_IP_PER_15_MIN=60
AUTH_REGISTER_IP_PER_HOUR=20
AUTH_RESET_ACCOUNT_PER_15_MIN=5
AUTH_RESET_IP_PER_15_MIN=30
AI_REQUESTS_PER_15_MIN=10
# Chỉ cấu hình tạm khi cần nhận dữ liệu local từ bản cũ. Dùng chuỗi ngẫu nhiên dài rồi xoá sau khi claim.
LEGACY_DATA_CLAIM_TOKEN=

# Production persistence (Supabase PostgreSQL/Auth)
DATABASE_URL=
DATABASE_POOL_MAX=5
# Base64 của certificate tải từ Supabase Database Settings → SSL Configuration.
DATABASE_CA_CERT_BASE64=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Production image storage (private Cloudflare R2 bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=production
# URL đọc ảnh R2 được ký ngắn hạn; byte ảnh đi thẳng R2 → client, không qua Render.
R2_SIGNED_READ_TTL_SECONDS=300

# Giai đoạn 3: chỉ cấu hình API key ở backend, tuyệt đối không dùng tiền tố VITE_.
IMAGE_PROVIDER=openrouter
MOCK_DELAY_MS=2000
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_IMAGE_RESOLUTION=768
OPENROUTER_IMAGE_ASPECT_RATIO=4:5
OPENROUTER_TIMEOUT_MS=120000
AI_MAX_CONCURRENCY=1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_MS=120000
APP_BASE_URL=http://127.0.0.1:8787
MUAPI_API_KEY=

# Billing (server-only). Leave a provider blank to disable its checkout button.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Optional overrides. Defaults to MoMo e-wallet checkout and the endpoint matching MOMO_ENVIRONMENT.
MOMO_REQUEST_TYPE=captureWallet
MOMO_ENDPOINT=
